{
  "name": "backend",
  "version": "0.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "codegen": {
    "schemas": "src/plugins"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "MIGRATE=true nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "vitest run --project unit --project e2e",
    "test:unit": "vitest --project unit --coverage",
    "test:e2e": "vitest --project e2e --coverage"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/platform-ws": "^11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/websockets": "^11.1.24",
    "@overtheairbrew/models": "workspace:*",
    "@overtheairbrew/mqtt": "workspace:*",
    "@overtheairbrew/plugins": "workspace:*",
    "@overtheairbrew/socket-events": "workspace:*",
    "bullmq": "^5.81.2",
    "generate-api-key": "^1.0.2",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.15.1",
    "mysql2": "^3.22.4",
    "nestjs-zod": "^5.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.24",
    "@overtheairbrew/codegen": "workspace:*",
    "@overtheairbrew/tsconfig": "workspace:*",
    "@suites/di.nestjs": "^3.1.0",
    "@suites/doubles.vitest": "^3.1.0",
    "@suites/unit": "^3.1.1",
    "@swc/core": "^1.15.47",
    "@testcontainers/mockserver": "^12.1.0",
    "@testcontainers/mosquitto": "^12.1.0",
    "@testcontainers/mysql": "^12.0.3",
    "@testcontainers/redis": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.3",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "unplugin-swc": "^1.5.10"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "src/data/migrations",
      "src/controllers",
      "src/auth",
      "src/data",
      "src/events/events.gateway.ts",
      "src/events/events.module.ts",
      "src/app.module.ts",
      "src/global.config.ts",
      "src/swagger-config.ts",
      "src/main.ts",
      "src/validation/exception.handler.ts"
    ]
  }
}