{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist"
      ],
      "cache": true
    },
    "start:dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test:unit": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    }
  }
}
